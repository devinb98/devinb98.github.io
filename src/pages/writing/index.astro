---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Writing" description="Dev logs and notes by Devin Bajaj — learning hard things in the open.">
  <section class="section">
    <div class="wrap">
      <header class="page-head">
        <h1>Writing</h1>
        <p class="lede">
          Dev logs from whatever I'm learning right now — the parts that were
          actually hard, written down while they're fresh.
        </p>
      </header>

      {posts.length === 0 ? (
        <p class="empty">First post is on its way. Check back soon.</p>
      ) : (
        <ul class="list">
          {posts.map((post) => (
            <li>
              <a href={`/writing/${post.id}`} class="row">
                <time datetime={post.data.date.toISOString().slice(0, 10)} class="mono date">
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' })}
                </time>
                <span class="text">
                  <span class="title">{post.data.title}</span>
                  <span class="summary">{post.data.summary}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  .page-head {
    margin-bottom: 2.5rem;
  }
  .page-head h1 {
    font-size: var(--step-4);
    margin-bottom: 0.75rem;
  }
  .lede {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 52ch;
  }
  .empty {
    color: var(--muted);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    align-items: baseline;
  }
  .row:hover {
    text-decoration: none;
  }
  .date {
    color: var(--faint);
  }
  .text {
    display: grid;
    gap: 0.35rem;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
  }
  .row:hover .title {
    color: var(--accent);
  }
  .summary {
    color: var(--muted);
    max-width: 60ch;
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
