---
// Typographic wrapper for rendered Markdown bodies.
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: var(--measure);
    line-height: 1.7;
  }
  .prose :global(h2) {
    font-size: var(--step-2);
    margin: 2.25rem 0 0.75rem;
  }
  .prose :global(h3) {
    font-size: var(--step-1);
    margin: 1.75rem 0 0.5rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.1em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }
  .prose :global(li) {
    margin-bottom: 0.35em;
  }
  .prose :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }
  .prose :global(pre) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem;
    overflow-x: auto;
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .prose :global(:not(pre) > code) {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  .prose :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--line);
    margin: 1.5em 0;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2em 0;
  }
</style>
