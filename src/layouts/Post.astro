---
import Base from './Base.astro';
import Prose from '../components/Prose.astro';

interface Props {
  title: string;
  date: Date;
  summary: string;
  tags?: string[];
}
const { title, date, summary, tags = [] } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const iso = date.toISOString().slice(0, 10);
---

<Base title={title} description={summary}>
  <article class="wrap post">
    <a href="/writing" class="back mono">/writing</a>
    <header class="post-head">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={iso} class="mono">{dateStr}</time>
        {tags.length > 0 && <span class="tags mono">{tags.join(', ')}</span>}
      </p>
    </header>
    <Prose>
      <slot />
    </Prose>
  </article>

  <style>
    .post {
      padding-block: clamp(2rem, 5vw, 3.5rem);
    }
    .back {
      display: inline-block;
      margin-bottom: 2rem;
    }
    .post-head {
      margin-bottom: 2.5rem;
    }
    .post-head h1 {
      font-size: var(--step-4);
      max-width: 24ch;
      margin-bottom: 1rem;
    }
    .meta {
      display: flex;
      gap: 1.25rem;
      flex-wrap: wrap;
      margin: 0;
    }
    .meta time {
      color: var(--muted);
    }
    .tags {
      color: var(--faint);
    }
  </style>
</Base>
